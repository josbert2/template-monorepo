// tsconfig.json
{
    "compilerOptions": {
      "outDir": "dist", // Donde se compilarán los archivos TypeScript (Rollup lo sobrescribirá)
      "module": "ESNext",
      "target": "ESNext",
      "lib": ["DOM", "DOM.Iterable", "ESNext"],
      "declaration": true, // Generar archivos .d.ts para tipos
      "jsx": "react-jsx", // Soporte para JSX en React 17+
      "moduleResolution": "node",
      "esModuleInterop": true,
      "resolveJsonModule": true,
      "strict": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true,
      "baseUrl": "./",
      "paths": {
        "*": ["src/*", "node_modules/*"]
      }
    },
    "include": ["src"], // Qué archivos incluir para la compilación
    "exclude": ["node_modules", "dist"]
  }